	file = {Full Text:C\:\\Users\\kobas\\Zotero\\storage\\J67UUHYR\\Reeder et al. - 2019 - Waterproof, electronics-enabled, epidermal microfluidic devices for sweat collection, biomarker anal.pdf:application/pdf},
}

