	title = {Circadian-like patterns in electrochemical skin conductance measured from home-based devices: a retrospective study},
	volume = {14},
	issn = {1664-2295},
	shorttitle = {Circadian-like patterns in electrochemical skin conductance measured from home-based devices},
	url = {https://www.frontiersin.org/articles/10.3389/fneur.2023.1249170/full},
	doi = {10.3389/fneur.2023.1249170},
	abstract = {In this study, we investigated the potential of electrochemical skin conductance (ESC) measurements gathered from home-based devices to detect circadian-like patterns. We analyzed data from 43,284 individuals using the Withings Body Comp or Body Scan scales, which provide ESC measurements. Our results highlighted a circadian pattern of ESC values across different age groups and countries. Our findings suggest that home-based ESC measurements could be used to evaluate circadian rhythm disorders associated with neuropathies and contribute to a better understanding of their pathophysiology. However, further controlled studies are needed to confirm these results. This study highlights the potential of digital health devices to generate new scientific and medical knowledge.},
	urldate = {2026-03-01},
