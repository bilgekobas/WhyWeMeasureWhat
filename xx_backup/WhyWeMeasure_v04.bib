	file = {Full Text:C\:\\Users\\kobas\\Zotero\\storage\\BXJSTD2U\\Brooks et al. - 2023 - Diurnal rhythms of wrist temperature are associated with future disease risk in the UK Biobank.pdf:application/pdf},
